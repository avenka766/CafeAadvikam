{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.12",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:audit": "node scripts/audit-regression.mjs",
    "test:wallet-promotions": "node --no-warnings --experimental-strip-types --experimental-specifier-resolution=node scripts/wallet-promotions-regression.mjs",
    "android:init": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "electron:dev": "cross-env ELECTRON_DEV_URL=http://localhost:8080 concurrently -k \"npm:dev\" \"wait-on tcp:8080 && electron .\"",
    "electron:start": "npm run build && electron .",
    "electron:build": "node scripts/check-desktop-config.mjs && npm run build && node scripts/prepare-desktop.cjs && electron-builder --win",
    "test:db": "node scripts/run-isolated-db-checks.mjs",
    "test:edge": "node scripts/test-edge-workflows.mjs",
    "test:native": "node --test electron/main.test.cjs electron/sales-ledger.test.cjs electron/billing-ledger.test.cjs electron/recovery-acceptance.test.cjs scripts/desktop-config.test.mjs"
  },
