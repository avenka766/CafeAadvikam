  },
  "build": {
    "appId": "com.cafeaadvikam.app",
    "productName": "Sri Nanjundeshwara Bakery",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "build/icon.ico",
      "!electron/smoke.cjs",
      "!electron/*.test.cjs"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build",
      "app": "desktop-app"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sri Nanjundeshwara Bakery",
      "artifactName": "SNB-Sweets-and-Bakes-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SNB-Sweets-and-Bakes-Portable-${version}.${ext}"
    },
    "electronVersion": "45.2.1",
    "beforeBuild": "./scripts/desktop-before-build.cjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5",
    "glob@>=9": "14.0.2",
    "minimatch@>=9": "11.0.1"
  }
}
